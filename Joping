const todayISO = () => new Date().toISOString().slice(0, 10);

function emptyParsed() {
  return {
    weight: null,
    jobsApplied: [],
    workoutCompleted: false,
    workoutDetails: null,
    steps: null,
    diet: null,
    study: null,
    mood: null,
    summary: '',
  };
}

async function parseJournalEntry(rawText) {
  const system = `You extract structured tracking data from a personal daily journal entry. Today's date is ${todayISO()}.
Return ONLY valid JSON, no markdown fences, no commentary. Schema:
{
  "weight": number|null,
  "jobsApplied": string[] (each item like "Company - role", empty array if none mentioned),
  "workoutCompleted": boolean,
  "workoutDetails": string|null,
  "steps": number|null,
  "diet": string|null,
  "study": string|null,
  "mood": string|null,
  "summary": string (one short plain sentence summarizing the day)
}
If a field isn't mentioned in the entry, use null (or empty array / false as appropriate). Do not invent details.`;

  const response = await fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      model: 'claude-sonnet-4-6',
      max_tokens: 1000,
      system,
      messages: [{ role: 'user', content: rawText }],
    }),
  });
  if (!response.ok) throw new Error('API request failed');
  const data = await response.json();
  const text = (data.content || []).map((b) => b.text || '').join('\n');
  const cleaned = text.replace(/```json|```/g, '').trim();
  const parsed = JSON.parse(cleaned);
  return { ...emptyParsed(), ...parsed };
}

export default function FieldLog() {
  const [entries, setEntries] = useState([]);
  const [loaded, setLoaded] = useState(false);
  const [rantText, setRantText] = useState('');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [lastStamp, setLastStamp] = useState(null);
  const [expandedId, setExpandedId] = useState(null);
  const [editingId, setEditingId] = useState(null);
  const [editDraft, setEditDraft] = useState(null);

  useEffect(() => {
    (async () => {
      try {
        const listRes = await window.storage.list('entries:');
        const keys = listRes && listRes.keys ? listRes.keys : [];
        const loadedEntries = [];
        for (const key of keys) {
          try {
            const res = await window.storage.get(key);
            if (res && res.value) loadedEntries.push(JSON.parse(res.value));
          } catch (e) { /* skip missing */ }
        }
        loadedEntries.sort((a, b) => (a.id < b.id ? 1 : -1));
        setEntries(loadedEntries);
      } catch (e) {
        // no entries yet
      } finally {
        setLoaded(true);
      }
    })();
  }, []);

  const handleSubmit = async () => {
    if (!rantText.trim() || loading) return;
    setLoading(true);
    setError(null);
    try {
      const parsed = await parseJournalEntry(rantText.trim());
      const id = Date.now().toString();
      const entry = { id, date: todayISO(), rawText: rantText.trim(), ...parsed };
      const result = await window.storage.set(`entries:${id}`, JSON.stringify(entry), false);
      if (!result) throw new Error('Could not save entry');
      setEntries((prev) => [entry, ...prev]);
      setLastStamp(entry);
      setRantText('');
    } catch (e) {
      setError("Couldn't log that — try again in a moment.");
    } finally {
      setLoading(false);
    }
  };

  const handleDelete = async (id) => {
    try {
      await window.storage.delete(`entries:${id}`);
      setEntries((prev) => prev.filter((e) => e.id !== id));
      if (lastStamp && lastStamp.id === id) setLastStamp(null);
    } catch (e) { /* ignore */ }
  };

  const startEdit = (entry) => {
    setEditingId(entry.id);
    setEditDraft({
      weight: entry.weight ?? '',
      jobsApplied: (entry.jobsApplied || []).join(', '),
      workoutCompleted: !!entry.workoutCompleted,
      workoutDetails: entry.workoutDetails || '',
      steps: entry.steps ?? '',
      diet: entry.diet || '',
      study: entry.study || '',
    });
  };

  const saveEdit = async (entry) => {
    const updated = {
      ...entry,
      weight: editDraft.weight === '' ? null : Number(editDraft.weight),
      jobsApplied: editDraft.jobsApplied.split(',').map((s) => s.trim()).filter(Boolean),
      workoutCompleted: editDraft.workoutCompleted,
      workoutDetails: editDraft.workoutDetails || null,
      steps: editDraft.steps === '' ? null : Number(editDraft.steps),
      diet: editDraft.diet || null,
      study: editDraft.study || null,
    };
    try {
      await window.storage.set(`entries:${entry.id}`, JSON.stringify(updated), false);
      setEntries((prev) => prev.map((e) => (e.id === entry.id ? updated : e)));
    } catch (e) { /* ignore */ }
    setEditingId(null);
  };

  const weightData = useMemo(() => {
    return entries
      .filter((e) => typeof e.weight === 'number')
      .map((e) => ({ date: e.date.slice(5), weight: e.weight }))
      .reverse();
  }, [entries]);

  const totalJobs = useMemo(
    () => entries.reduce((sum, e) => sum + (e.jobsApplied ? e.jobsApplied.length : 0), 0),
    [entries]
  );

  const recentJobs = useMemo(() => {
    const list = [];
    entries.forEach((e) => (e.jobsApplied || []).forEach((j) => list.push({ date: e.date, job: j })));
    return list.slice(0, 6);
  }, [entries]);

  const studyLog = useMemo(() => entries.filter((e) => e.study).slice(0, 6), [entries]);
  const dietLog = useMemo(() => entries.filter((e) => e.diet).slice(0, 6), [entries]);

  const streak = useMemo(() => {
    const byDate = {};
    entries.forEach((e) => {
      if (e.workoutCompleted) byDate[e.date] = true;
    });
    let count = 0;
    let d = new Date();
    while (true) {
      const key = d.toISOString().slice(0, 10);
      if (byDate[key]) {
        count++;
        d.setDate(d.getDate() - 1);
      } else break;
    }
    return count;
  }, [entries]);

  const last14 = useMemo(() => {
    const byDate = {};
    entries.forEach((e) => {
      if (e.workoutCompleted) byDate[e.date] = true;
    });
    const days = [];
    for (let i = 13; i >= 0; i--) {
      const d = new Date();
      d.setDate(d.getDate() - i);
      const key = d.toISOString().slice(0, 10);
      days.push(!!byDate[key]);
    }
    return days;
  }, [entries]);

  return (
    <div className="fl-root">
      <style>{STYLE}</style>
      <p className="fl-eyebrow">Field Log</p>
      <h1 className="fl-h1">Say what happened today</h1>
      <p className="fl-sub">weight · jobs applied · workout · diet · study — write it like you'd tell a friend</p>

      <div className="fl-rant">
        <textarea
          className="fl-textarea"
          placeholder={`e.g. "Woke up at 5, did push day — bench, incline, delts felt strong. Walked about 9k steps so far. Applied to Target and Home Depot. Weighed 178 this morning. Studied for about an hour, went over anatomy terms. Ate pretty clean, chicken and rice for lunch."`}
          value={rantText}
          onChange={(e) => setRantText(e.target.value)}
        />
        <div className="fl-rant-footer">
          {loading && <Loader2 size={15} style={{ animation: 'spin 1s linear infinite' }} />}
          <button className="fl-btn" onClick={handleSubmit} disabled={loading || !rantText.trim()}>
            <Send size={14} />
            {loading ? 'Reading it...' : 'Log it'}
          </button>
        </div>
        {error && <p className="fl-error">{error}</p>}
      </div>

      {lastStamp && (
        <div className="fl-stamp">
          <Check size={15} style={{ marginTop: 2, flexShrink: 0 }} />
          <div>
            <b>Logged {lastStamp.date}.</b> {lastStamp.summary}
          </div>
        </div>
      )}

      <div className="fl-grid">
        <div className="fl-card">
          <div className="fl-card-title"><Dumbbell size={13} /> Weight trend</div>
          {weightData.length > 1 ? (
            <ResponsiveContainer width="100%" height={140}>
              <LineChart data={weightData}>
                <CartesianGrid stroke="#34322E" vertical={false} />
                <XAxis dataKey="date" stroke="#928F87" fontSize={11} tickLine={false} axisLine={false} />
                <YAxis stroke="#928F87" fontSize={11} domain={['auto', 'auto']} tickLine={false} axisLine={false} width={34} />
                <Tooltip contentStyle={{ background: '#1F1E23', border: '1px solid #34322E', borderRadius: 6, fontSize: 12 }} />
                <Line type="monotone" dataKey="weight" stroke="#5C8B86" strokeWidth={2} dot={{ r: 3, fill: '#5C8B86' }} />
              </LineChart>
            </ResponsiveContainer>
          ) : (
            <p className="fl-empty">Log your weight a couple times to see a trend.</p>
          )}
        </div>

        <div className="fl-card">
          <div className="fl-card-title"><Flame size={13} /> Workout streak</div>
          <div className="fl-stat-row">
            <span className="fl-stat-num">{streak}</span>
            <span className="fl-stat-label">day{streak === 1 ? '' : 's'} in a row</span>
          </div>
          <div className="fl-streak-dots">
            {last14.map((on, i) => (
              <div key={i} className={`fl-dot${on ? ' on' : ''}`} />
            ))}
          </div>
        </div>
      </div>

      <div className="fl-grid">
        <div className="fl-card">
          <div className="fl-card-title"><Briefcase size={13} /> Jobs applied — {totalJobs} total</div>
          {recentJobs.length ? (
            <ul className="fl-list">
              {recentJobs.map((j, i) => (
                <li key={i}><span className="fl-date">{j.date.slice(5)}</span>{j.job}</li>
              ))}
            </ul>
          ) : (
            <p className="fl-empty">No applications logged yet.</p>
          )}
        </div>

        <div className="fl-card">
          <div className="fl-card-title"><BookOpen size={13} /> Study log</div>
          {studyLog.length ? (
            <ul className="fl-list">
              {studyLog.map((e) => (
                <li key={e.id}><span className="fl-date">{e.date.slice(5)}</span>{e.study}</li>
              ))}
            </ul>
          ) : (
            <p className="fl-empty">No study notes yet.</p>
          )}
        </div>
      </div>

      <div className="fl-card" style={{ marginBottom: 14 }}>
        <div className="fl-card-title"><Utensils size={13} /> Diet notes</div>
        {dietLog.length ? (
          <ul className="fl-list">
            {dietLog.map((e) => (
              <li key={e.id}><span className="fl-date">{e.date.slice(5)}</span>{e.diet}</li>
            ))}
          </ul>
        ) : (
          <p className="fl-empty">No diet notes yet.</p>
        )}
      </div>

      <div className="fl-history">
        <div className="fl-history-title">Full history — {entries.length} entries</div>
        {!loaded ? (
          <p className="fl-empty">Loading...</p>
        ) : entries.length === 0 ? (
          <p className="fl-empty">Nothing logged yet — write your first entry above.</p>
        ) : (
          entries.map((entry) => (
            <div className="fl-entry" key={entry.id}>
              <div className="fl-entry-head" onClick={() => setExpandedId(expandedId === entry.id ? null : entry.id)}>
                <span className="fl-entry-date">{entry.date}</span>
                <span className="fl-entry-summary">{entry.summary}</span>
                <span className="fl-entry-icons">
                  {entry.workoutCompleted && <Dumbbell size={13} />}
                  {entry.jobsApplied && entry.jobsApplied.length > 0 && <Briefcase size={13} />}
                  {entry.study && <BookOpen size={13} />}
                  {entry.diet && <Utensils size={13} />}
                </span>
              </div>
              {expandedId === entry.id && (
                <div className="fl-entry-body">
                  {editingId === entry.id ? (
                    <div className="fl-edit-form">
                      <div className="fl-edit-row"><label>Weight</label><input className="fl-input" type="number" value={editDraft.weight} onChange={(e) => setEditDraft({ ...editDraft, weight: e.target.value })} /></div>
                      <div className="fl-edit-row"><label>Jobs</label><input className="fl-input" value={editDraft.jobsApplied} onChange={(e) => setEditDraft({ ...editDraft, jobsApplied: e.target.value })} placeholder="Company - role, Company - role" /></div>
                      <div className="fl-edit-row"><label>Workout</label><input className="fl-checkbox" type="checkbox" checked={editDraft.workoutCompleted} onChange={(e) => setEditDraft({ ...editDraft, workoutCompleted: e.target.checked })} /></div>
                      <div className="fl-edit-row"><label>Details</label><input className="fl-input" value={editDraft.workoutDetails} onChange={(e) => setEditDraft({ ...editDraft, workoutDetails: e.target.value })} /></div>
                      <div className="fl-edit-row"><label>Steps</label><input className="fl-input" type="number" value={editDraft.steps} onChange={(e) => setEditDraft({ ...editDraft, steps: e.target.value })} /></div>
                      <div className="fl-edit-row"><label>Diet</label><input className="fl-input" value={editDraft.diet} onChange={(e) => setEditDraft({ ...editDraft, diet: e.target.value })} /></div>
                      <div className="fl-edit-row"><label>Study</label><input className="fl-input" value={editDraft.study} onChange={(e) => setEditDraft({ ...editDraft, study: e.target.value })} /></div>
                      <div className="fl-entry-actions">
                        <button className="fl-icon-btn" onClick={() => saveEdit(entry)}><Check size={12} /> Save</button>
                        <button className="fl-icon-btn" onClick={() => setEditingId(null)}><X size={12} /> Cancel</button>
                      </div>
                    </div>
                  ) : (
                    <>
                      <div>{entry.rawText}</div>
                      <div className="fl-entry-actions">
                        <button className="fl-icon-btn" onClick={() => startEdit(entry)}><Pencil size={12} /> Fix</button>
                        <button className="fl-icon-btn" onClick={() => handleDelete(entry.id)}><Trash2 size={12} /> Delete</button>
                      </div>
                    </>
                  )}
                </div>
              )}
            </div>
          ))
        )}
      </div>
    </div>
  );
}
